# Frontend environment variables (copy to frontend/.env and fill in)

# Sentry: the frontend reports to the same shared Sentry project as the
# backend Python services (see shared/sentry.py) and is distinguished by the
# `service: frontend` tag. Leave VITE_SENTRY_DSN blank to disable Sentry
# locally.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_SAMPLE_RATE=1.0
# Optional performance-tracing sample rate; blank disables tracing
VITE_SENTRY_TRACES_SAMPLE_RATE=
