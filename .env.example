# Environment variables (copy to .env and fill in)

# Canonical data directory for OHLCV, backtests, catalogs
# Linux default: ~/data | Windows example: C:\trading-data
DATA_DIR=./data

# Legacy fallback used if DATA_DIR is not set
TRADING_DATA_DIR=./data

# Log directory
LOG_DIR=./logs

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Uvicorn runtime defaults
UVICORN_HOST=0.0.0.0
UVICORN_PORT=5556

# Optional: required for Strategy Lab auto-conversion agent
NVIDIA_API_KEY=

# Optional: GitHub Copilot SDK provider (runner/llm_providers/copilot_sdk_provider.py)
# Auth fallback order in SDK includes: COPILOT_GITHUB_TOKEN, GH_TOKEN, GITHUB_TOKEN, stored CLI login.
COPILOT_GITHUB_TOKEN=
GH_TOKEN=
GITHUB_TOKEN=
# Optional model override used when provider=copilot_sdk and request model is omitted.
COPILOT_SDK_MODEL=gpt-5
# Optional local Copilot CLI binary path for SDK subprocess mode.
COPILOT_CLI_PATH=


# Dukascopy Account (for JForex Downloader)
DUKASCOPY_USERNAME=dukascopy_account_username_here
DUKASCOPY_PASSWORD=dukascopy_account_password_here
