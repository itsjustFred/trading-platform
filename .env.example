# Environment variables (copy to .env and fill in)
# No secrets needed for Phase 1 — backtesting is local-only.

# Data directory — all OHLCV, backtests, catalogs are stored here
# Linux default: ~/data | Windows example: C:\trading-data
TRADING_DATA_DIR=~/data

# Log directory
LOG_DIR=~/logs

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Viewer/Flask port
FLASK_PORT=5556
