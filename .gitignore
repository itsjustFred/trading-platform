# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Distribution / packaging
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/*
!.vscode/mcp.json
.obsidian/
.pi/tau-instances/
~/.pi/tau-instances/
*.swp
*.swo

# Environment (.env.example allowed)
.env
*.env
.env.*
!*.env.example

# OS
.DS_Store
Thumbs.db

# User data (lives in $TRADING_DATA_DIR, not in repo)
data/
logs/

# Node
node_modules/

# Frontend build output (must be built locally)
frontend/dist/

# Data files (managed separately in $TRADING_DATA_DIR)
*.parquet
*.csv
!tests/fixtures/*.csv
!tests/fixtures/*.json

# Cache/temp
.pytest_cache/
.ruff_cache/
.playwright-mcp
temp/
tmp/

# uv
uv.lock
.accounts.env

# Kimchi runtime data (generated, large)
.kimchi/

# Graphify outputs (keep in .gitignore for large/local files)
graphify-out/
!graphify-out/wiki/
!graphify-out/GRAPH_REPORT.md

# Generated backtest artifacts (large, regenerated)
*.trades.json
reports/*.csv
reports/*.trades.json
frontend/public/matrix-grid-overview.json
