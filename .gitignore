# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Distribution / packaging
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Environment (.env.example allowed)
.env
*.env
.env.*
!*.env.exmaple

# OS
.DS_Store
Thumbs.db

# User data (lives in $TRADING_DATA_DIR, not in repo)
data/
logs/

# Node
node_modules/

# Frontend build output (must be built locally)
frontend/dist/

# Data files (managed separately in $TRADING_DATA_DIR)
*.parquet
*.csv
!tests/fixtures/*.csv
!tests/fixtures/*.json

# Cache
.pytest_cache/
.ruff_cache/

# uv
uv.lock
.accounts.env
