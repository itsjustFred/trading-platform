# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/

# Distribution / packaging
*.egg-info/
dist/
build/

# IDE
.idea/
.vscode/*
!.vscode/mcp.json
.obsidian/
.pi/tau-instances/
~/.pi/tau-instances/
*.swp
*.swo

# Environment (.env.example allowed)
.env
*.env
.env.*
!*.env.example

# OS
.DS_Store
Thumbs.db

# User data (lives in $TRADING_DATA_DIR, not in repo)
data/
logs/

# Node
node_modules/

# Frontend build output (must be built locally)
frontend/dist/

# Data files (managed separately in $TRADING_DATA_DIR)
*.parquet
*.csv
!tests/fixtures/*.csv
!tests/fixtures/*.json

# Cache/temp
.pytest_cache/
.ruff_cache/
.playwright-mcp
temp/
tmp/

# uv
uv.lock
.accounts.env


# graphify - keep graph outputs, skip heavy/local-only files

graphify-out/.graphify_python
graphify-out/.graphify_uncached.txt
graphify-out/cache/
graphify-out/manifest.json
graphify-out/cost.json
